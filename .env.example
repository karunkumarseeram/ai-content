OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-omni-1.2-flash

# Instagram API with Unified Login: use the Instagram account ID and its token.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v27.0
PUBLIC_BASE_URL=
CONTROL_TOKEN=

# YouTube OAuth: run `python -m app.oauth_setup` once before unattended publishing.
GOOGLE_OAUTH_CLIENT_SECRETS=data/client_secret.json
GOOGLE_OAUTH_TOKEN_FILE=data/youtube-token.json

OUTPUT_DIR=data
NEWS_FEEDS_JSON=
POSTING_TIME=18:00
TIMEZONE=Asia/Kolkata
FFMPEG_BIN=ffmpeg
